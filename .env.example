# Copy to .env.local and fill in. Never commit .env.local.
# Only publishable (browser-safe) values are needed. This app never uses a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional display limits (defaults match the Supabase Free plan: 50 MB per file, 1 GB total).
NEXT_PUBLIC_MAX_UPLOAD_BYTES=52428800
NEXT_PUBLIC_STORAGE_QUOTA_BYTES=1073741824

# Only used by scripts/backup.mjs (run on your own computer, never deployed).
HUB_OWNER_EMAIL=
HUB_OWNER_PASSWORD=
